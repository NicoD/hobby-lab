{
    "name": "hobby-lab/outbox-bundle",
    "type": "symfony-bundle",
    "require": {
        "php": ">=8.4",
        "doctrine/doctrine-bundle": "^3.0",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "symfony/config": "8.0.*",
        "symfony/console": "8.0.*",
        "symfony/dependency-injection": "8.0.*",
        "symfony/http-kernel": "8.0.*",
        "symfony/messenger": "8.0.*",
        "symfony/uid": "8.0.*"
    },
    "autoload": {
        "psr-4": {
            "Outbox\\": "src/"
        }
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "8.0.*"
        }
    }
}
